generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  TEACHER
  INSTRUCTOR
  STUDENT
}

enum AuthProvider {
  GOOGLE
}

enum UserStatus {
  INVITED
  ACTIVE
  BLOCKED
  ARCHIVED
}

enum OrganizationStatus {
  ACTIVE
  BLOCKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

enum InvitationEmailStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  SUPERSEDED
}

enum GroupStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

/// Навчальний статус учня. Не плутати з UserStatus (обліковий доступ).
/// PRACTICE призначається лише допуском до практики.
enum TrainingStatus {
  INVITED
  ACTIVE
  PRACTICE
  GRADUATED
  DROPPED
  ARCHIVED
}

enum LicenseCategory {
  A
  B
  C
  D
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum DrivingLessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// Експлуатаційний статус автомобіля автошколи.
/// INACTIVE не переходить одразу в MAINTENANCE: спочатку AVAILABLE.
enum CarStatus {
  AVAILABLE
  MAINTENANCE
  INACTIVE
}

model Organization {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String             @db.VarChar(255)
  slug           String             @unique @db.VarChar(100)
  email          String             @unique @db.VarChar(255)
  phone          String?            @db.VarChar(20)
  address        String?            @db.VarChar(255)
  status         OrganizationStatus @default(ACTIVE)
  logoUrl        String?            @map("logo_url") @db.VarChar(2048)
  timezone       String             @default("Europe/Kyiv") @db.VarChar(64)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")
  users          User[]
  invitations    Invitation[]
  groups         Group[]
  students       Student[]
  cars           Car[]
  drivingLessons DrivingLesson[]

  @@index([deletedAt])
  @@map("organizations")
}

model User {
  id                       String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                    String               @unique @db.VarChar(255)
  passwordHash             String?              @map("password_hash") @db.VarChar(255)
  firstName                String               @map("first_name") @db.VarChar(100)
  lastName                 String               @map("last_name") @db.VarChar(100)
  phone                    String?              @db.VarChar(20)
  avatarUrl                String?              @map("avatar_url") @db.VarChar(2048)
  role                     UserRole
  status                   UserStatus           @default(ACTIVE)
  organizationId           String               @map("organization_id") @db.Uuid
  lastLoginAt              DateTime?            @map("last_login_at")
  tokensInvalidBefore      DateTime?            @map("tokens_invalid_before")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  deletedAt                DateTime?            @map("deleted_at")
  organization             Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  oauthAccounts            OAuthAccount[]
  oauthAuthorizations      OAuthAuthorization[]
  refreshToken             RefreshToken[]
  passwordResetToken       PasswordResetToken[]
  sentInvitations          Invitation[]         @relation("SentInvitations")
  receivedInvitations      Invitation[]         @relation("ReceivedInvitations")
  taughtGroups             Group[]              @relation("TeacherGroups")
  enrollments              Enrollment[]         @relation("StudentEnrollments")
  studentProfile           Student?             @relation("StudentProfile")
  instructedStudents       Student[]            @relation("StudentInstructor")
  instructorCars           Car[]                @relation("InstructorCars")
  instructorDrivingLessons DrivingLesson[]      @relation("InstructorDrivingLessons")
  studentDrivingLessons    DrivingLesson[]      @relation("StudentDrivingLessons")

  @@index([deletedAt])
  @@index([organizationId])
  @@map("users")
}

model OAuthAccount {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id") @db.VarChar(255)
  email             String?      @db.VarChar(255)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model OAuthAuthorization {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  state        String   @unique @db.VarChar(255)
  nonce        String   @db.VarChar(255)
  codeVerifier String   @map("code_verifier") @db.VarChar(255)
  userId       String?  @map("user_id") @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("oauth_authorizations")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  userAgent String?   @map("user_agent") @db.VarChar(512)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_token")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Invitation {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String           @db.VarChar(255)
  role           UserRole
  tokenHash      String           @unique @map("token_hash") @db.VarChar(128)
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  invitedById    String           @map("invited_by_id") @db.Uuid
  invitedBy      User             @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  userId         String           @map("user_id") @db.Uuid
  user           User             @relation("ReceivedInvitations", fields: [userId], references: [id], onDelete: Cascade)
  organizationId String           @map("organization_id") @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  emailJobs      InvitationEmailJob[]

  @@index([userId])
  @@index([organizationId])
  @@index([invitedById])
  @@index([email])
  @@map("invitations")
}

/// Задача на відправку листа-запрошення. Сирий token тримається лише до завершення задачі.
model InvitationEmailJob {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invitationId      String                 @map("invitation_id") @db.Uuid
  invitation        Invitation             @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  token             String?                @db.VarChar(128)
  tokenHash         String                 @map("token_hash") @db.VarChar(128)
  status            InvitationEmailStatus  @default(QUEUED)
  attempts          Int                    @default(0)
  lastError         String?                @map("last_error") @db.VarChar(500)
  providerMessageId String?                @map("provider_message_id") @db.VarChar(512)
  nextAttemptAt     DateTime               @default(now()) @map("next_attempt_at")
  sentAt            DateTime?              @map("sent_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@index([invitationId, createdAt])
  @@map("invitation_email_jobs")
}

model Group {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String       @db.VarChar(120)
  status         GroupStatus  @default(PLANNED)
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teacherId      String       @map("teacher_id") @db.Uuid
  teacher        User         @relation("TeacherGroups", fields: [teacherId], references: [id], onDelete: Cascade)
  startDate      DateTime?    @map("start_date")
  endDate        DateTime?    @map("end_date")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  enrollments    Enrollment[]
  lessons        Lesson[]
  students       Student[]

  @@index([organizationId])
  @@index([teacherId])
  @@map("groups")
}

model Student {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String           @unique @map("user_id") @db.Uuid
  user           User             @relation("StudentProfile", fields: [userId], references: [id], onDelete: Cascade)
  organizationId String           @map("organization_id") @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  groupId        String?          @map("group_id") @db.Uuid
  group          Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  instructorId   String?          @map("instructor_id") @db.Uuid
  instructor     User?            @relation("StudentInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  carId          String?          @map("car_id") @db.Uuid
  car            Car?             @relation(fields: [carId], references: [id], onDelete: SetNull)
  category       LicenseCategory?
  transmission   Transmission?
  trainingStatus TrainingStatus   @default(INVITED) @map("training_status")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([groupId])
  @@index([instructorId])
  @@index([carId])
  @@map("students")
}

model Car {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instructorId   String          @map("instructor_id") @db.Uuid
  instructor     User            @relation("InstructorCars", fields: [instructorId], references: [id], onDelete: Cascade)
  plateNumber    String          @map("plate_number") @db.VarChar(16)
  category       LicenseCategory
  transmission   Transmission
  status         CarStatus       @default(AVAILABLE)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  students       Student[]

  @@unique([organizationId, plateNumber])
  @@index([organizationId])
  @@index([instructorId])
  @@map("cars")
}

model Enrollment {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId    String           @map("group_id") @db.Uuid
  group      Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId  String           @map("student_id") @db.Uuid
  student    User             @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now()) @map("enrolled_at")

  @@unique([groupId, studentId])
  @@index([groupId])
  @@index([studentId])
  @@map("enrollments")
}

model Lesson {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId     String       @map("group_id") @db.Uuid
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  topic       String       @db.VarChar(200)
  scheduledAt DateTime     @map("scheduled_at")
  durationMin Int          @default(90) @map("duration_min")
  status      LessonStatus @default(SCHEDULED)
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([groupId])
  @@index([scheduledAt])
  @@map("lessons")
}

model DrivingLesson {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instructorId   String              @map("instructor_id") @db.Uuid
  instructor     User                @relation("InstructorDrivingLessons", fields: [instructorId], references: [id], onDelete: Cascade)
  studentId      String              @map("student_id") @db.Uuid
  student        User                @relation("StudentDrivingLessons", fields: [studentId], references: [id], onDelete: Cascade)
  scheduledAt    DateTime            @map("scheduled_at")
  durationMin    Int                 @default(60) @map("duration_min")
  status         DrivingLessonStatus @default(SCHEDULED)
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([instructorId])
  @@index([studentId])
  @@index([scheduledAt])
  @@map("driving_lessons")
}
