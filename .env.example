# Application
NODE_ENV=development
PORT=3000

# HMAC secret for access/refresh tokens. Change this in any shared or production environment.
AUTH_SECRET=change-me-in-production

# Comma-separated browser origins allowed to call the API (Vite default: 5173).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth 2.0 / OpenID Connect (Authorization Code + PKCE).
# Leave all three empty to run without Google sign-in. Set all three together to enable it.
# Redirect URI must match the Google Cloud client. Defaults to local callback if omitted.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Optional. If set, callback 302-redirects here with tokens in the URL hash.
GOOGLE_OAUTH_SUCCESS_REDIRECT=http://localhost:5173

# PostgreSQL connection for commands that run on the host
# (npm run start:dev, npx prisma migrate, npx prisma studio).
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/stage_drive

# PostgreSQL connection for backend and migrate containers in docker-compose.
# Host must be the Compose service name (`postgres`), not localhost.
DOCKER_DATABASE_URL=postgresql://postgres:postgres_password@postgres:5432/stage_drive

# Local PostgreSQL container (not used when the database already runs on a VM)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=stage_drive
POSTGRES_PORT=5432

MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=